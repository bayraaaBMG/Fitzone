rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per account. Access stays owner-only; on top of that,
    // writes must keep the shape the app actually uses (js/state.js save()).
    //
    // Only the fields a write actually changes are validated (diff against
    // the stored doc), so an older document with a legacy field can still
    // be saved, but no write can add an unknown top-level field or put a
    // wrong type / oversized value into a known one. Firestore rules can't
    // loop over lists or maps, so nested checks cover the newest workout
    // result and its exercise stats (the entries each workout save adds);
    // the app also sanitizes everything it reads (js/auth.js).
    //
    // Staff (see "roles" below) can read any account, and a moderator or
    // admin may change only its 30-day `challenge` — never anything else.
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(appFields())
        && validFields(request.resource.data, request.resource.data.keys().toSet());
      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(appFields())
          && validFields(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()))
        || (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challenge', 'updatedAt'])
          && validChallenge(request.resource.data.get('challenge', null)));
    }

    // ================= roles & admin content =================
    //
    // Who is staff is decided here, never by the client:
    //  * owner     — the account signed in as OWNER_EMAIL with a verified
    //                email (Google sign-in is always verified). Fixed in
    //                these rules, so no document or client can grant or
    //                revoke it. A custom claim {role:'owner'} also counts.
    //  * admin     — roles/{uid}.role == 'admin', or custom claim admin:true
    //  * moderator — roles/{uid}.role == 'moderator'
    // Only the owner can write roles/*. js/roles.js mirrors this to decide
    // what to show; hiding a button there is a convenience, these rules are
    // the protection.
    function signedIn() { return request.auth != null; }
    function ownerEmail() { return 'bbayraaa20@gmail.com'; }
    function isOwnerAccount() {
      return signedIn() && (request.auth.token.get('role', '') == 'owner'
        || (request.auth.token.get('email', '') == ownerEmail()
            && request.auth.token.get('email_verified', false) == true));
    }
    function storedRole() {
      return !signedIn() ? '' : roleAt(/databases/$(database)/documents/roles/$(request.auth.uid));
    }
    function roleAt(p) { return exists(p) ? get(p).data.get('role', '') : ''; }
    function isAdmin() {
      return isOwnerAccount()
        || (signedIn() && request.auth.token.get('admin', false) == true)
        || storedRole() == 'admin';
    }
    function isStaff() { return isAdmin() || storedRole() == 'moderator'; }

    // plain text that ends up in the page: no markup, bounded length
    function txt(s, max) { return s is string && s.size() <= max && s.matches('[^<>]*'); }
    function optTxt(m, k, max) { return !(k in m) || txt(m[k], max); }
    function numIn(v, lo, hi) { return v is number && v >= lo && v <= hi; }
    function stamped(d) { return d.updatedBy == request.auth.uid && d.updatedAt is number; }

    match /roles/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create, update: if isOwnerAccount()
        && request.resource.data.keys().hasOnly(['role', 'email', 'name', 'grantedBy', 'grantedAt'])
        && request.resource.data.role in ['admin', 'moderator']
        && request.resource.data.grantedBy == request.auth.uid
        && request.resource.data.grantedAt is number
        && optTxt(request.resource.data, 'email', 200) && optTxt(request.resource.data, 'name', 60);
      allow delete: if isOwnerAccount();
    }

    // A small public-to-staff card per account, written by the account
    // itself (js/roles.js touchDirectory) so the admin user list does not
    // have to download every full users/{uid} document.
    match /directory/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow delete: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'name', 'goal', 'level', 'place', 'joinedAt', 'lastSeen'])
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
        && optTxt(request.resource.data, 'name', 60) && optTxt(request.resource.data, 'goal', 30)
        && optTxt(request.resource.data, 'place', 30) && optTxt(request.resource.data, 'joinedAt', 10)
        && (!('level' in request.resource.data) || request.resource.data.level in [1, 2, 3])
        && request.resource.data.lastSeen is number;
    }

    // Exercise library edits. A document either overrides the built-in
    // exercise with the same id (js/data.js) or adds a new one; hidden:true
    // takes it out of the library and the planner. Every signed-in user
    // reads these, so every text field is checked for markup and the video
    // is a YouTube id or an https link to a video/GIF file.
    match /exercises/{id} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && validExercise(request.resource.data, id);
    }
    function validExercise(d, id) {
      return id.matches('[a-z0-9_-]{2,40}') && d.id == id
        && d.keys().hasOnly(['id', 'n', 'e', 'loc', 'm', 'lvl', 'eq', 'kcal', 'video', 'goals',
                             'tgt', 'tech', 'err', 'easy', 'hard', 'en', 'hidden', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['n', 'loc', 'm', 'lvl', 'eq', 'kcal', 'goals', 'hidden'])
        && txt(d.n, 80) && optTxt(d, 'e', 16)
        && d.loc in ['home', 'gym']
        && d.m in ['chest', 'back', 'legs', 'glutes', 'shoulders', 'arms', 'abs', 'cardio']
        && d.lvl in [1, 2, 3]
        && d.eq in ['none', 'dumbbell', 'barbell', 'machine', 'cable']
        && numIn(d.kcal, 0, 40)
        && d.goals is list && d.goals.size() <= 5
        && d.goals.hasOnly(['fatloss', 'muscle', 'tone', 'strength', 'health'])
        && (!('video' in d) || (d.video is string && (d.video == ''
              || d.video.matches('[A-Za-z0-9_-]{11}')
              || d.video.matches('https://[A-Za-z0-9./_~%-]{4,300}[.](mp4|webm|gif)'))))
        && optTxt(d, 'tgt', 200) && optTxt(d, 'tech', 1200) && optTxt(d, 'err', 600)
        && optTxt(d, 'easy', 200) && optTxt(d, 'hard', 200)
        && (!('en' in d) || validExerciseEn(d.en))
        && d.hidden is bool
        && stamped(d);
    }
    function validExerciseEn(m) {
      return m is map && m.keys().hasOnly(['n', 'tgt', 'tech', 'err', 'easy', 'hard'])
        && optTxt(m, 'n', 80) && optTxt(m, 'tgt', 200) && optTxt(m, 'tech', 1200)
        && optTxt(m, 'err', 600) && optTxt(m, 'easy', 200) && optTxt(m, 'hard', 200);
    }

    // config/app    the home-screen announcement and the calorie algorithm's
    //               tunable numbers (js/content.js clamps them again on read)
    // config/pages  admin overrides of the app's on-screen text, {mn:{key:text}, en:{…}}
    // config/legal  overrides of the privacy policy and terms, read by the
    //               public pages without signing in, so readable by anyone
    // Rules cannot loop over a map, so the text values of pages/legal are
    // bounded only by count and document size here. They are made safe where
    // they are used: js/content.js strips < > " before the app renders one,
    // and js/public.js writes legal text with textContent only.
    match /config/{doc} {
      allow read: if signedIn() || doc == 'legal';
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && (
        (doc == 'app' && validConfig(request.resource.data))
        || (doc == 'pages' && validPages(request.resource.data))
        || (doc == 'legal' && validLegal(request.resource.data)));
    }
    function textMap(m, max) { return m is map && m.size() <= max; }
    function validPages(d) {
      return d.keys().hasOnly(['mn', 'en', 'updatedAt', 'updatedBy'])
        && (!('mn' in d) || textMap(d.mn, 1000)) && (!('en' in d) || textMap(d.en, 1000))
        && stamped(d);
    }
    function validLegalPage(p) {
      return p is map && p.keys().hasOnly(['mn', 'en', 'updated'])
        && (!('mn' in p) || textMap(p.mn, 200)) && (!('en' in p) || textMap(p.en, 200))
        && (!('updated' in p) || (p.updated is string && p.updated.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')));
    }
    function validLegal(d) {
      return d.keys().hasOnly(['privacy', 'terms', 'updatedAt', 'updatedBy'])
        && (!('privacy' in d) || validLegalPage(d.privacy))
        && (!('terms' in d) || validLegalPage(d.terms))
        && stamped(d);
    }
    function validConfig(d) {
      return d.keys().hasOnly(['announce', 'calc', 'updatedAt', 'updatedBy'])
        && (!('announce' in d) || (d.announce is map
              && d.announce.keys().hasOnly(['on', 'mn', 'en'])
              && d.announce.get('on', false) is bool
              && optTxt(d.announce, 'mn', 300) && optTxt(d.announce, 'en', 300)))
        && (!('calc' in d) || validCalc(d.calc))
        && stamped(d);
    }
    function validCalc(c) {
      return c is map
        && c.keys().hasOnly(['activity', 'deficit', 'surplus', 'proteinPerKg', 'fatShare', 'careFloor', 'floorM', 'floorF'])
        && (!('activity' in c) || (c.activity is map && c.activity.keys().hasOnly(['1', '2', '3', '4', '5'])
              && numIn(c.activity.get('1', 1.2), 1, 2.5) && numIn(c.activity.get('2', 1.3), 1, 2.5)
              && numIn(c.activity.get('3', 1.45), 1, 2.5) && numIn(c.activity.get('4', 1.65), 1, 2.5)
              && numIn(c.activity.get('5', 1.8), 1, 2.5)))
        && (!('deficit' in c) || numIn(c.deficit, 0.6, 1))
        && (!('surplus' in c) || numIn(c.surplus, 1, 1.3))
        && (!('proteinPerKg' in c) || numIn(c.proteinPerKg, 0.8, 3))
        && (!('fatShare' in c) || numIn(c.fatShare, 0.15, 0.45))
        && (!('careFloor' in c) || numIn(c.careFloor, 0.8, 1))
        && (!('floorM' in c) || numIn(c.floorM, 1000, 2500))
        && (!('floorF' in c) || numIn(c.floorF, 800, 2500));
    }

    // Append-only record of what staff changed. Nobody can edit or delete it.
    match /adminLog/{id} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['by', 'byEmail', 'action', 'target', 'note', 'at'])
        && request.resource.data.by == request.auth.uid
        && txt(request.resource.data.action, 40) && txt(request.resource.data.target, 128)
        && optTxt(request.resource.data, 'byEmail', 200) && optTxt(request.resource.data, 'note', 300)
        && request.resource.data.at is number;
      allow update, delete: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function appFields() {
      return ['profile', 'plan', 'weights', 'measures', 'completed', 'completedLog', 'challenge', 'pantry',
              'foodLog', 'waterLog', 'theme', 'lang', 'exStats', 'workoutResults', 'updatedAt'];
    }

    // --- per-field checks (applied only to fields in `ch`) ---
    function validFields(d, ch) {
      return (!ch.hasAny(['profile']) || validProfile(d.profile))
        && (!ch.hasAny(['plan']) || d.plan == null || (d.plan is list && d.plan.size() <= 14))
        && (!ch.hasAny(['weights']) || (d.weights is list && d.weights.size() <= 5000))
        && (!ch.hasAny(['measures']) || validMeasures(d.measures))
        && (!ch.hasAny(['completed']) || (d.completed is list && d.completed.size() <= 5000))
        && (!ch.hasAny(['completedLog']) || (d.completedLog is map && d.completedLog.size() <= 5000))
        && (!ch.hasAny(['challenge']) || validChallenge(d.challenge))
        && (!ch.hasAny(['pantry']) || (d.pantry is list && d.pantry.size() <= 300))
        && (!ch.hasAny(['foodLog']) || (d.foodLog is map && d.foodLog.size() <= 5000))
        && (!ch.hasAny(['waterLog']) || (d.waterLog is map && d.waterLog.size() <= 5000))
        && (!ch.hasAny(['theme']) || d.theme in ['dark', 'light', 'system'])
        && (!ch.hasAny(['lang']) || d.lang in ['mn', 'en'])
        && (!ch.hasAny(['exStats']) || validExStats(d.exStats, d))
        && (!ch.hasAny(['workoutResults']) || validResults(d.workoutResults))
        && (!ch.hasAny(['updatedAt']) || d.updatedAt is number);
    }

    function optStr(m, k, max) { return !(k in m) || m[k] == null || (m[k] is string && m[k].size() <= max); }
    function optNum(m, k) { return !(k in m) || m[k] == null || m[k] is number; }

    function validProfile(p) {
      return p == null || (p is map && p.size() <= 30
        && optStr(p, 'name', 200) && optStr(p, 'sex', 10) && optStr(p, 'goal', 30)
        && optStr(p, 'place', 30) && optStr(p, 'joinedAt', 10)
        && optNum(p, 'age') && optNum(p, 'height') && optNum(p, 'weight')
        && optNum(p, 'days') && optNum(p, 'minutes') && optNum(p, 'level')
        // answers from the onboarding wizard; all optional, so a profile
        // written by an older client still validates
        && optNum(p, 'activity') && optNum(p, 'targetWeight') && optNum(p, 'waist') && optNum(p, 'sleep')
        && optStr(p, 'diet', 30)
        && (!('health' in p) || (p.health is list && p.health.size() <= 20))
        && (!('equip' in p) || (p.equip is list && p.equip.size() <= 50))
        // 200×200 canvas JPEG is ~10–40 KB; only image data URLs, never other schemes
        && (!('photo' in p) || p.photo == null || (p.photo is string && p.photo.size() <= 300000
              && p.photo.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))));
    }

    // body measurements: [{d:'YYYY-MM-DD', waist?, chest?, hip?, thigh?, arm?}] in cm.
    // Checked like `weights`: the list and its length only. Reaching into the
    // entries costs expressions per element and blows the 1000-expression
    // budget on a long list, so entry shape is the client sanitizer's job
    // (cleanMeasures in js/auth.js). The cap is 1000 — measurements are taken
    // weekly or monthly, so that is decades of entries.
    function validMeasures(l) {
      return l is list && l.size() <= 1000;
    }

    function validChallenge(c) {
      return c == null || (c is map && c.start is string && c.start.size() == 10
        && (!('done' in c) || (c.done is list && c.done.size() <= 60)));
    }

    function validResult(r) {
      return r is map && r.size() <= 20
        && r.exerciseId is string && r.exerciseId.size() <= 40
        && r.mode in ['reps', 'time']
        && r.reps is number && r.heldSec is number && r.duration is number
        && r.score is number && r.completedAt is number
        && optStr(r, 'id', 80) && optStr(r, 'userId', 128)
        && (!('opponent' in r) || r.opponent is map);
    }
    function validResults(l) {
      return l is list && l.size() <= 50 && (l.size() == 0 || validResult(l[0]));
    }

    // (`last` duplicates the newest workout result, which validResults already checks)
    function validStat(s) {
      return s is map && s.size() <= 20
        && s.sessions is number && s.streak is number
        && (s.lastDay == null || (s.lastDay is string && s.lastDay.size() == 10))
        && (!('last' in s) || s.last == null || s.last is map);
    }
    // the exercise of the newest result is the entry a workout save just changed.
    // Kept cheap on purpose: rules stop at 1000 evaluated expressions per request.
    function validExStats(m, d) {
      return m is map && m.size() <= 100 && newestStatOk(m, d.get('workoutResults', []));
    }
    function newestStatOk(m, l) {
      let key = (l is list && l.size() > 0 && l[0] is map) ? l[0].get('exerciseId', null) : null;
      return !(key is string) || !(key in m) || validStat(m[key]);
    }
  }
}
