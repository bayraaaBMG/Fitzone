{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://fitzone-7f325.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/Fitzone.html",
      "destination": "/MongolFit.html"
    },
    {
      "source": "/app",
      "destination": "/MongolFit.html"
    },
    {
      "source": "/login",
      "destination": "/MongolFit.html"
    },
    {
      "source": "/register",
      "destination": "/MongolFit.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
